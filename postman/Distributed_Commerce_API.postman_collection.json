{
  "info": {
    "name": "Distributed Digital Commerce & Inventory Intelligence API",
    "description": "Comprehensive Postman API Collection for KL University Course 25CS1302E (DBS-DBD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login as Customer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abhinay@klh.edu.in\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@commerce.kluniversity.in\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Get Current Profile (JWT Auth)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"]}
          }
        }
      ]
    },
    {
      "name": "02. Catalog & Products",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"]}
          }
        },
        {
          "name": "Get Product by ID (Cache-Aside)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/products/prod_lap_01", "host": ["{{baseUrl}}"], "path": ["api", "products", "prod_lap_01"]}
          }
        },
        {
          "name": "Get AI Vector Recommendations",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/products/prod_lap_01/recommendations", "host": ["{{baseUrl}}"], "path": ["api", "products", "prod_lap_01", "recommendations"]}
          }
        },
        {
          "name": "Create New Product (Admin RBAC)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quantum Accelerator PCIe\",\n  \"sku\": \"QA-PCIE-100\",\n  \"price\": 899.00,\n  \"category_id\": \"cat_comp_01\",\n  \"description\": \"Dedicated tensor computation accelerator card\",\n  \"attributes\": {\"tops\": 120, \"vram_gb\": 16},\n  \"tags\": [\"ai\", \"hardware\"]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"]}
          }
        }
      ]
    },
    {
      "name": "03. Inventory & Multi-Warehouse",
      "item": [
        {
          "name": "List All Warehouses",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "warehouses"]}
          }
        },
        {
          "name": "List All Inventory",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/inventory", "host": ["{{baseUrl}}"], "path": ["api", "inventory"]}
          }
        },
        {
          "name": "Reserve Stock for Checkout (TTL Lock)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouse_id\": \"wh_hyd_01\",\n  \"quantity\": 1\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inventory/prod_lap_01/reserve", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "prod_lap_01", "reserve"]}
          }
        },
        {
          "name": "Restock Inventory (Manager/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"prod_audio_03\",\n  \"warehouse_id\": \"wh_hyd_01\",\n  \"delta\": 20,\n  \"note\": \"Warehouse restock shipment batch\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inventory", "host": ["{{baseUrl}}"], "path": ["api", "inventory"]}
          }
        },
        {
          "name": "Get Inventory Audit Logs",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/inventory/audit", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "audit"]}
          }
        }
      ]
    },
    {
      "name": "04. Orders & ACID Transactions",
      "item": [
        {
          "name": "Place Order (ACID Atomic Transaction)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"prod_lap_01\",\n      \"warehouse_id\": \"wh_hyd_01\",\n      \"quantity\": 1\n    }\n  ],\n  \"shipping_address\": \"CSE Block, KL University, Hyderabad\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"]}
          }
        },
        {
          "name": "List User Orders",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"]}
          }
        }
      ]
    },
    {
      "name": "05. Intelligence & Diagnostics",
      "item": [
        {
          "name": "Get Demand Forecast & Restock Intelligence",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/intelligence/forecast", "host": ["{{baseUrl}}"], "path": ["api", "intelligence", "forecast"]}
          }
        },
        {
          "name": "Run Automated TC01-TC10 Test Suite",
          "request": {
            "method": "POST",
            "url": {"raw": "{{baseUrl}}/api/tests/run", "host": ["{{baseUrl}}"], "path": ["api", "tests", "run"]}
          }
        }
      ]
    }
  ]
}
